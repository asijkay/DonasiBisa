# ---------- App ----------
NODE_ENV="development"
# development | preview | production. Simulator & dev-login HANYA aktif jika "development".
APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Asia/Jakarta"

# ---------- PostgreSQL (Neon / lokal) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/donasibisa"
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5433/donasibisa"

# ---------- Auth.js / Google ----------
# openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-dev-only-change-me"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST="true"
# Pisahkan dengan koma. Email Google terverifikasi di daftar ini mendapat SUPER_ADMIN saat login pertama.
ADMIN_EMAIL_ALLOWLIST="admin@example.com"

# ---------- Midtrans ----------
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
PAYMENTS_MIDTRANS_ENABLED="false"

# ---------- Xendit ----------
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
XENDIT_API_VERSION="2024-11-11"
PAYMENTS_XENDIT_ENABLED="false"

# ---------- Simulator gateway (DEV ONLY) ----------
# Jika true dan APP_ENV=development, adapter memanggil simulator lokal
# (/api/dev/gateway/*) dengan key dummy; webhook tetap lewat verifikasi signature asli.
PAYMENT_SIMULATOR="true"

# ---------- Upstash (opsional; kosong = fallback in-memory / inline) ----------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ---------- Email ----------
# Resend (disarankan; HTTP API). Jika RESEND_API_KEY diisi, Resend dipakai; selain itu Gmail SMTP di bawah.
# Tanpa domain terverifikasi, pengirim harus onboarding@resend.dev dan hanya sampai ke email pemilik akun Resend.
RESEND_API_KEY=""
# Gmail SMTP (alternatif)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_APP_PASSWORD=""
EMAIL_FROM_NAME="Nama Platform"
EMAIL_FROM_ADDRESS=""
NOTIFICATIONS_EMAIL_ENABLED="false"

# ---------- WhatsApp (Fonnte) ----------
FONNTE_TOKEN=""
NOTIFICATIONS_WHATSAPP_ENABLED="false"

# ---------- Pengaturan donasi ----------
MIN_DONATION_AMOUNT="10000"
MAX_DONATION_AMOUNT="100000000"
