{
  "name": "donasibisa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "jobs:run": "tsx --conditions=react-server --env-file=.env.local scripts/run-jobs.ts",
    "qstash:schedules": "tsx --env-file=.env.local scripts/setup-qstash-schedules.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@upstash/qstash": "^2.12.1",
    "@upstash/redis": "^1.41.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@tailwindcss/node": {
      "magic-string": "0.30.21"
    },
    "nodemailer": "$nodemailer"
  }
}
